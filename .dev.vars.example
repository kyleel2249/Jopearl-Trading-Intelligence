# Cloudflare Pages Functions local development variables.
# Public exchange market data does not need API keys or a separate gateway.
JPTI_TRADING_MODE=paper
JPTI_ENABLE_LIVE_TRADING=false
# Native app CORS is restricted in the Pages Function to standard Capacitor origins.

# Private D1 journal, session-memory and GainzAlpha outcome synchronization.
# Copy this file to .dev.vars and replace the placeholder with a long random secret.
# Never commit the real .dev.vars file.
JPTI_JOURNAL_TOKEN=replace-with-a-long-random-secret

# Optional Bitget CFD market-data credentials for a local Cloudflare Pages dev session.
JPTI_BITGET_API_KEY=
JPTI_BITGET_API_SECRET=
JPTI_BITGET_API_PASSPHRASE=

# Optional FRED API key for Federal Reserve yields, policy rates and bank balance-sheet data.
# Configure this as a Cloudflare Pages secret in production; never commit a real key.
FRED_API_KEY=

# BIS SDMX catalogue discovery and rotating financial-series monitoring are automatic; no key or URL is required.
# Legacy BIS_LBS_DATA_URL is retained only for compatibility with older local configurations.
BIS_LBS_DATA_URL=

# Optional Bitquery multi-chain wallet-label enrichment. Provider labels are not cryptographic proof.
BITQUERY_ACCESS_TOKEN=

# Optional global economic calendar (Trading Economics) and company earnings/IPO calendar (Finnhub).
TRADING_ECONOMICS_API_KEY=
# Optional crypto ecosystem event and token unlock providers.
COINMARKETCAL_API_KEY=
TOKENOMIST_API_KEY=

# Optional verified wallet registry JSON. Keep this server-side; use evidence-backed records only.
# Example shape: [{"chain":"ethereum","address":"0x...","claims":[{"type":"official-entity-registry","verified":true,"registryRecordId":"record-id","entityName":"Entity","entityType":"exchange","source":"Official registry","sourceUrl":"https://..."}]}]
JPTI_VERIFIED_WALLET_REGISTRY=[]

# Optional Trading Economics global macro calendar and Finnhub earnings/IPO calendar.
TRADING_ECONOMICS_API_KEY=
FINNHUB_API_KEY=

# Additional verified event calendar JSON. Official FOMC, ECB, BoE, BoJ, EIA and Treasury calendars are fetched automatically.
# Entries are direction-neutral unless an actual/forecast mapping is explicitly provided.
JPTI_EVENT_CALENDAR_JSON=[]
