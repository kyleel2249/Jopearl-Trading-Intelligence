# Local Cloudflare Pages Functions secrets for: npx wrangler pages dev dist
# Copy to .dev.vars and replace the placeholder with a long random secret.
# Never commit the real .dev.vars file.
JPTI_JOURNAL_TOKEN=replace-with-a-long-random-secret

# Optional: only required for signed Bitget CFD read-only endpoints.
JPTI_BITGET_API_KEY=
JPTI_BITGET_API_SECRET=
JPTI_BITGET_API_PASSPHRASE=
