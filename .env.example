# JPTI — Cloudflare Pages build configuration
# These VITE_* values are public and are compiled into the browser bundle.
VITE_APP_NAME=JPTI
VITE_APP_ENV=production
# Leave blank on Cloudflare Pages web deployments: /api/* is served by Pages Functions.
# For Android/native builds only, set this to the public Cloudflare Pages origin.
VITE_API_BASE_URL=
VITE_WS_URL=
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_CRASH_REPORTING=true
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ENABLE_CONFIG_DIAGNOSTICS=true

# Bitget CFD charts only: set these as encrypted Cloudflare Pages secrets in production.
# Never expose these through VITE_ variables or browser code.
JPTI_BITGET_API_KEY=
JPTI_BITGET_API_SECRET=
JPTI_BITGET_API_PASSPHRASE=

# Workers AI spending guard (server-side, optional). Counts real model calls in a rolling window.
# A positive whole number sets the cap; "unlimited" disables it. Defaults: 60 per hour, 400 per day.
# Each agent task reserves room for 2 calls and each department mission for 4.
JPTI_AI_HOURLY_LIMIT=
JPTI_AI_DAILY_LIMIT=
