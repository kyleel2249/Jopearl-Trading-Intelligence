{
  "name": "jpti-trading-intelligence",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "node --watch api/server.js",
    "start:api": "node api/server.js",
    "dev:all": "concurrently \"npm:dev\" \"npm:dev:api\"",
    "build": "vite build",
    "build:pages": "node scripts/check-env.mjs && vite build && node scripts/verify-pages-build.mjs",
    "verify:pages": "node scripts/verify-pages-build.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "check": "node scripts/apply-tbots-adapter.mjs && node scripts/check-syntax.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "test": "node --test",
    "backtest:walkforward": "node scripts/walk-forward.mjs",
    "desktop:dev": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder",
    "mobile:android:add": "cap add android",
    "mobile:sync": "npm run build && cap sync",
    "mobile:android:open": "cap open android",
    "mobile:android:run": "npm run build && cap sync android && cap run android",
    "smoke": "node scripts/runtime-smoke.mjs",
    "env:check": "node scripts/check-env.mjs",
    "dev:pages": "npm run build && npx wrangler pages dev dist",
    "deploy:pages": "npm run build:pages && npx wrangler pages deploy dist --project-name jpti",
    "db:d1:list": "wrangler d1 migrations list JPTI_DB --remote --config ./wrangler.toml",
    "db:d1:apply": "wrangler d1 migrations apply JPTI_DB --remote --config ./wrangler.toml",
    "verify:bitget:live": "node scripts/verify-bitget-live.mjs",
    "verify:chart-intelligence": "node scripts/verify-chart-intelligence.mjs",
    "verify:institutional-intelligence": "node scripts/verify-institutional-intelligence.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.468.0",
    "ccxt": "^4.5.93",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "dotenv": "^16.4.7",
    "zod": "^4.6.7",
    "pg": "^8.13.1",
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/splash-screen": "^7.0.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "@capacitor/cli": "^7.4.3",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "typescript": "^5.8.3",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "wrangler": "4.167.0"
  },
  "main": "desktop/app/main.cjs",
  "build": {
    "appId": "com.jopearl.jpti",
    "productName": "JPTI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "api/**/*",
      "integrations/t-bots/public/**/*",
      "desktop/app/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "JPTI Maintainers <125039072+kyleel2249@users.noreply.github.com>"
    }
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
